{
  "name": "dazzle-mcp",
  "version": "0.2.0",
  "description": "Local stdio and public Streamable HTTP MCP server for Dazzle",
  "type": "module",
  "bin": {
    "dazzle-mcp": "dist/server.js"
  },
  "exports": "./dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/server.ts --format esm --dts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dazzle-core": "workspace:*",
    "dazzle-magicui": "workspace:^",
    "playwright-core": "^1.55.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
